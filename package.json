{
  "name": "cubeclicker",
  "private": true,
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "podman compose up",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "smoke": "podman compose -f compose.yaml -f compose.smoke.yaml run --rm smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^16",
    "typescript": "~5.9",
    "typescript-eslint": "^8"
  }
}
