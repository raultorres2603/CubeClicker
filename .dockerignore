# Version control and editor noise
.git
.gitattributes
.gitignore

# Dependencies and build output (rebuilt inside the images)
node_modules
**/node_modules
dist
**/dist
coverage
**/coverage
*.tsbuildinfo

# Local configuration and secrets (.env files are user-owned; never baked into images)
.env*

# Not needed to build the images (keeps the build context small).
# NOTE: src/** manifests, tsconfig.json and package*.json are intentionally NOT excluded — the Dockerfiles copy them.
docs
tests
.opencode
opencode.jsonc
README.md
